{
  "name": "theme-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Contrast checking for design tokens. Discovers your real colour pairings from your CSS and fails the build when they regress.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:node": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:node && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chroma-js": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.1",
    "vitest": "^4.1.10"
  },
  "bin": {
    "theme-lab": "dist-node/bin/theme-lab.js",
    "theme-lab-mcp": "dist-node/mcp/server.js"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "contrast",
    "design-tokens",
    "design-system",
    "css",
    "css-variables",
    "custom-properties",
    "color",
    "cli",
    "ci",
    "mcp",
    "linter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hashtagsmile/react-color-tester.git"
  },
  "homepage": "https://react-color-tester.vercel.app",
  "bugs": {
    "url": "https://github.com/Hashtagsmile/react-color-tester/issues"
  },
  "files": [
    "dist-node",
    "README.md",
    "LICENSE"
  ]
}
